# FaceIQ webapp - local development. Copy to .env.local and fill in.
#
# Postgres 19 via Homebrew (no Docker):
#   brew install postgresql && brew services start postgresql
#   psql -U $(whoami) -d postgres -c "CREATE ROLE faceiq LOGIN PASSWORD 'faceiq' CREATEDB;"
#   psql -U $(whoami) -d postgres -c "CREATE DATABASE faceiq OWNER faceiq;"
#   npx prisma migrate deploy
#
# Secrets: there is no mandatory production secret today (custom session
# cookies, spec 7.x). Real values for any sensitive vars go in .env.local,
# which is gitignored.

DATABASE_URL="postgresql://faceiq:faceiq@localhost:5432/faceiq"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Request logging level: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# Google OAuth (dev only; empty means sign-in UI is hidden in dev).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=""
